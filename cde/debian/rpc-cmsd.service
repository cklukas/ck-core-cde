[Unit]
Description=CK Core CDE Calendar Manager Service Daemon (rpc.cmsd)
Documentation=man:rpc.cmsd(1)
After=local-fs.target
ConditionPathExists=/usr/dt/bin/rpc.cmsd

[Service]
Type=simple
RuntimeDirectory=rpc.cmsd
RuntimeDirectoryMode=0755
ExecStart=/usr/dt/bin/rpc.cmsd -s -u
KillSignal=SIGHUP
Restart=on-failure
RestartSec=2
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
