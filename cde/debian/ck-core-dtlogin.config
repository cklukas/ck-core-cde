#!/bin/sh
set -e

. /usr/share/debconf/confmodule

THIS_PACKAGE=ck-core-dtlogin
DEFAULT_DISPLAY_MANAGER_FILE=/etc/X11/default-display-manager

db_metaget shared/default-x-display-manager owners || OWNERS=""
db_subst shared/default-x-display-manager choices "$OWNERS"

if [ -e "$DEFAULT_DISPLAY_MANAGER_FILE" ]; then
    CURRENT_DM=$(cat "$DEFAULT_DISPLAY_MANAGER_FILE" 2>/dev/null || true)
    if [ "$CURRENT_DM" = "/usr/dt/bin/dtlogin" ]; then
        db_set shared/default-x-display-manager "$THIS_PACKAGE" || true
    fi
else
    db_get shared/default-x-display-manager || true
    if [ -z "$RET" ]; then
        db_set shared/default-x-display-manager "$THIS_PACKAGE" || true
    fi
fi

COUNT=$(printf '%s' "$OWNERS" | awk -F', ' '{print NF}')
if [ "${COUNT:-0}" -gt 1 ]; then
    db_input high shared/default-x-display-manager || true
    db_go || true
fi

exit 0
