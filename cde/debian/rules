#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	./autogen.sh
	PKG_CONFIG_PATH=/usr/dt/lib/pkgconfig \
	CPPFLAGS="$(CPPFLAGS) -I/usr/dt/include $$(pkg-config --cflags xft)" \
	LDFLAGS="$(LDFLAGS) -L/usr/dt/lib -Wl,-rpath,/usr/dt/lib" \
	./configure --prefix=/usr/dt --with-ck-core-fs CC=clang CXX=clang++

override_dh_auto_build:
	$(MAKE) -j1 -C programs/dtksh prepare-ksh
	dh_auto_build --max-parallel=6
