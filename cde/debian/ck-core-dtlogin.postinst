#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! id -u _dtgreeter >/dev/null 2>&1; then
        useradd --system --user-group --home-dir /var/dt --no-create-home \
            --shell /usr/sbin/nologin _dtgreeter || true
    fi
    for grp in video render input; do
        if getent group "$grp" >/dev/null 2>&1; then
            usermod -a -G "$grp" _dtgreeter >/dev/null 2>&1 || true
        fi
    done
    mkdir -p /var/dt /run/dtlogin
    chmod 0755 /var/dt /run/dtlogin

    . /usr/share/debconf/confmodule
    DEFAULT_DISPLAY_MANAGER_FILE=/etc/X11/default-display-manager
    DAEMON=/usr/dt/bin/dtlogin

    db_get shared/default-x-display-manager || RET=""
    if [ "$RET" = "ck-core-dtlogin" ] || [ ! -e "$DEFAULT_DISPLAY_MANAGER_FILE" ]; then
        mkdir -p /etc/X11
        printf '%s\n' "$DAEMON" > "$DEFAULT_DISPLAY_MANAGER_FILE"
        if [ -d /etc/systemd/system ]; then
            ln -sf /lib/systemd/system/dtlogin.service /etc/systemd/system/display-manager.service
        fi
    fi
    db_stop || true
fi

exit 0
