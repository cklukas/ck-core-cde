Package: ck-core-cde
Architecture: any
Depends: ck-core-motif9 (>= 2.4.0),
         ck-core-fs-lib (>= 0.3.0),
         ksh93u+m | ksh,
         rpcbind,
         x11-xserver-utils,
         xfonts-base,
         xwayland | xserver-xorg-core,
         ${shlibs:Depends},
         ${misc:Depends}
Recommends: ck-core-apps,
            xfonts-100dpi,
            xserver-xorg
Conflicts: cde-desktop
Replaces: cde-desktop
Description: CK Core Common Desktop Environment (X11/XLibre and Wayland)
 Modernized, C23-hardened Common Desktop Environment built as a matched native
 cohort with CK Core Motif ABI 9 and ck-core-fs-lib. Provides both classic
 X11/XLibre (/usr/share/xsessions/cde.desktop) and Wayland
 (/usr/share/wayland-sessions/cde-wayland.desktop) desktop sessions.

Package: ck-core-dtlogin
Architecture: any
Depends: ck-core-cde (= ${binary:Version}),
         debconf (>= 0.5) | debconf-2.0,
         ${shlibs:Depends},
         ${misc:Depends}
Provides: x-display-manager
Description: CK Core CDE graphical login and display manager
 Provides dtlogin, dtgreet, PAM systemd-logind integration, and Debian/Ubuntu
 default-display-manager debconf registration for launching Wayland and
 X11/XLibre desktop sessions.
