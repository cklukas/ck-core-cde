#!/bin/sh
# CK Core CDE Wayland session entry point (/usr/share/wayland-sessions/cde-wayland.desktop)
set -eu

export PATH="/usr/dt/bin:$PATH"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-CDE}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-cde-wayland}"
export XDG_SESSION_TYPE="wayland"
export XFILESEARCHPATH="${XFILESEARCHPATH:-/usr/dt/app-defaults/%L/%N:/usr/dt/app-defaults/C/%N}"
export CDE_BACKDROP_DIR="${CDE_BACKDROP_DIR:-/usr/dt/backdrops}"

if [ -n "${HOME:-}" ]; then
    mkdir -p "$HOME/.dt/types" "$HOME/.dt/sessions" "$HOME/.dt/appmanager" "$HOME/.dt/icons" 2>/dev/null || true
fi
export DTUSERSESSION="${USER:-$(id -un)}-wayland"
if [ -x /usr/dt/bin/dtsearchpath ]; then
    eval "$(/usr/dt/bin/dtsearchpath -ksh 2>/dev/null)" || true
fi

if [ -x /usr/dt/bin/dtwm-wayland ]; then
    if [ -x /usr/dt/bin/dtsession ] && /usr/dt/bin/dtsession --help 2>&1 | grep -q -- '--wayland'; then
        exec /usr/dt/bin/dtsession --wayland
    fi
    exec /usr/dt/bin/dtwm-wayland --session
fi

echo "Xsession.wayland: /usr/dt/bin/dtwm-wayland is not yet installed" >&2
exit 1
