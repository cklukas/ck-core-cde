#!/bin/sh
# CK Core CDE Wayland session entry point (/usr/share/wayland-sessions/cde-wayland.desktop)
set -eu

export PATH="/usr/dt/bin:$PATH"
# Never inherit a stale parent WAYLAND_DISPLAY / DISPLAY into the root session compositor
unset WAYLAND_DISPLAY DISPLAY
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-CDE}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-cde-wayland}"
export XDG_SESSION_TYPE="wayland"
if [ -z "${LANG:-}" ] || [ "${LANG}" = "C" ] || [ "${LANG}" = "POSIX" ]; then
    if command -v locale >/dev/null 2>&1 && locale -a 2>/dev/null | grep -qi '^en_US\.utf-\?8$'; then
        export LANG="en_US.UTF-8"
    else
        export LANG="C.UTF-8"
    fi
fi
export XFILESEARCHPATH="${XFILESEARCHPATH:-/usr/dt/app-defaults/%L/%N:/usr/dt/app-defaults/C/%N}"
export CDE_BACKDROP_DIR="${CDE_BACKDROP_DIR:-/usr/dt/backdrops}"

if [ -n "${HOME:-}" ]; then
    mkdir -p "$HOME/.dt/types" "$HOME/.dt/sessions" "$HOME/.dt/appmanager" "$HOME/.dt/icons" "$HOME/.dt/ims" 2>/dev/null || true
    if [ -f "$HOME/.dt/accessibility.conf" ] && [ -z "${XM_ACCESSIBILITY:-}" ]; then
        if grep -Eq '^[[:space:]]*atspi_bridge[[:space:]]*=[[:space:]]*(1|true|yes|on)[[:space:]]*$' "$HOME/.dt/accessibility.conf" 2>/dev/null; then
            export XM_ACCESSIBILITY=1
        fi
    fi
fi
export DTUSERSESSION="${USER:-$(id -un)}-wayland"
if [ -x /usr/dt/bin/dtsearchpath ]; then
    set +u
    eval "$(/usr/dt/bin/dtsearchpath -ksh 2>/dev/null)" || true
    set -u
fi
if [ -x /usr/dt/bin/dtappgather ]; then
    /usr/dt/bin/dtappgather >/dev/null 2>&1 || true
fi
if [ -x /usr/dt/bin/dtappintegrate ]; then
    /usr/dt/bin/dtappintegrate --xdg >/dev/null 2>&1 || true
    /usr/dt/bin/dtappintegrate --xdg --watch \
        --pidfile "${XDG_RUNTIME_DIR:-/tmp}/ck-xdg-watch-wayland.pid" >/dev/null 2>&1 &
fi
if [ -x /usr/dt/bin/cde-color-sync ]; then
    /usr/dt/bin/cde-color-sync --daemon >/dev/null 2>&1 &
fi
if [ -x /usr/dt/bin/dtwm-media-ctl ]; then
    /usr/dt/bin/dtwm-media-ctl bright-restore >/dev/null 2>&1 || true
fi
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
    eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null)" || true
    export SSH_AUTH_SOCK
fi
# Ensure PipeWire + WirePlumber + PipeWire-Pulse are active when not socket-activated by systemd --user
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ ! -S "$XDG_RUNTIME_DIR/pulse/native" ]; then
    if command -v systemctl >/dev/null 2>&1 && systemctl --user start pipewire.service wireplumber.service pipewire-pulse.socket >/dev/null 2>&1; then
        :
    elif command -v pipewire >/dev/null 2>&1; then
        [ -S "$XDG_RUNTIME_DIR/pipewire-0" ] || pipewire >/dev/null 2>&1 &
        command -v wireplumber >/dev/null 2>&1 && wireplumber >/dev/null 2>&1 &
        command -v pipewire-pulse >/dev/null 2>&1 && pipewire-pulse >/dev/null 2>&1 &
    fi
fi
export XBMLANGPATH="${XBMLANGPATH:-${HOME:+$HOME/.dt/icons/%B%M.bm:$HOME/.dt/icons/%B:}/usr/dt/appconfig/icons/%L/%B%M.bm:/usr/dt/appconfig/icons/%L/%B:/usr/dt/appconfig/icons/C/%B%M.bm:/usr/dt/appconfig/icons/C/%B:/usr/dt/include/X11/bitmaps/%B:/usr/include/X11/bitmaps/%B:%D}"

# Synchronize CDE IMS selection (~/.dt/ims/*) or installed Wayland IME (fcitx5 / ibus)
# so native Wayland zwp_text_input_v3 clients and Motif XWayland XmIm clients share one daemon.
CDE_IMS_CHOICE=""
if [ -n "${HOME:-}" ] && [ -d "$HOME/.dt/ims" ]; then
    CDE_IMS_CHOICE="$(awk '/^@ims:/{print $2; exit}' "$HOME/.dt/ims/"* 2>/dev/null || true)"
fi
if [ -z "$CDE_IMS_CHOICE" ]; then
    if [ -x /usr/bin/fcitx5 ]; then
        CDE_IMS_CHOICE="fcitx5"
    elif [ -x /usr/bin/ibus-daemon ]; then
        CDE_IMS_CHOICE="ibus"
    fi
fi
export CDE_WAYLAND_IMS="$CDE_IMS_CHOICE"
case "$CDE_IMS_CHOICE" in
    fcitx5|fcitx)
        export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
        export GTK_IM_MODULE="${GTK_IM_MODULE:-wayland}"
        export QT_IM_MODULE="${QT_IM_MODULE:-wayland}"
        ;;
    ibus)
        export XMODIFIERS="${XMODIFIERS:-@im=ibus}"
        export GTK_IM_MODULE="${GTK_IM_MODULE:-ibus}"
        export QT_IM_MODULE="${QT_IM_MODULE:-ibus}"
        ;;
esac

if [ -x /usr/dt/bin/dtwm-wayland ]; then
    if [ -x /usr/dt/bin/dtsession ] && /usr/dt/bin/dtsession --help 2>&1 | grep -q -- '--wayland'; then
        exec /usr/dt/bin/dtsession --wayland
    fi
    exec /usr/dt/bin/dtwm-wayland --session --startup 'if command -v dbus-update-activation-environment >/dev/null 2>&1; then dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XMODIFIERS GTK_IM_MODULE QT_IM_MODULE SSH_AUTH_SOCK XM_ACCESSIBILITY >/dev/null 2>&1 || dbus-update-activation-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XMODIFIERS GTK_IM_MODULE QT_IM_MODULE SSH_AUTH_SOCK XM_ACCESSIBILITY >/dev/null 2>&1 || true; fi; case "${CDE_WAYLAND_IMS:-}" in fcitx5|fcitx) command -v fcitx5 >/dev/null 2>&1 && fcitx5 -d >/dev/null 2>&1 & ;; ibus) command -v ibus-daemon >/dev/null 2>&1 && ibus-daemon -drx >/dev/null 2>&1 & ;; esac; command -v ck-polkit-agent >/dev/null 2>&1 && ck-polkit-agent >/dev/null 2>&1 & command -v ck-status >/dev/null 2>&1 && ck-status --daemon >/dev/null 2>&1 & _midi_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/ck-core/midi.conf"; if [ -f "$_midi_cfg" ] && grep -q "^virtual_port=1" "$_midi_cfg" && command -v ck-midi >/dev/null 2>&1; then ck-midi --daemon >/dev/null 2>&1 & fi'
fi

echo "Xsession.wayland: /usr/dt/bin/dtwm-wayland is not yet installed" >&2
exit 1
