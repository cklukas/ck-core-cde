[Unit]
Description=CK Core CDE Display Manager (dtlogin)
Documentation=man:dtlogin(1)
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service plymouth-quit.service network.target rpcbind.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c '[ "$(cat /etc/X11/default-display-manager 2>/dev/null)" = "/usr/dt/bin/dtlogin" ]'
ExecStart=/usr/dt/bin/dtlogin -nodaemon
Restart=always
RestartSec=2

[Install]
Alias=display-manager.service
