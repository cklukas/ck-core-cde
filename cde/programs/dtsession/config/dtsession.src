/*
 * The PAM service of the screen lock.  dtsession asks it for one thing: is
 * this the password of the user who started the session, and may that
 * account be used.  The user is fixed by dtsession (the account of its real
 * user ID); the stack must authenticate the user it is given and must not
 * accept the password of another account (no pam_rootok, no pam_succeed_if
 * rules that let anyone in).  Sessions and password changes are not used.
 */
#ifdef PAM_AUTHENTICATION_MODULE
auth sufficient PAM_AUTHENTICATION_MODULE
#endif
auth required pam_unix.so

account required pam_unix.so

session required pam_deny.so

password required pam_deny.so
