XCOMM!KORNSHELL
XCOMM
XCOMM dtopen - XDG MIME & modern desktop helper launcher for CK-Core CDE
XCOMM          (Wayland & X11/XLibre).
XCOMM

DTOPEN="dtopen"
APPNAME="$(basename "$0")"
DTAPPINT_XDG=CDE_INSTALLATION_TOP/bin/dtappintegrate-xdg

XCOMM Default helper chains (modern Ubuntu/Linux viewers ahead of legacy X11 viewers)
if [ -z "$DTOPEN_VIMAGE" ]
then
    VIMAGE="loupe eog gthumb feh sxiv display gimp xv"
else
    VIMAGE="$DTOPEN_VIMAGE"
fi

if [ -z "$DTOPEN_VVIDEO" ]
then
    VVIDEO="mpv vlc totem celluloid ffplay"
else
    VVIDEO="$DTOPEN_VVIDEO"
fi

if [ -z "$DTOPEN_VAUDIO" ]
then
    VAUDIO="mpv vlc rhythmbox audacious ffplay"
else
    VAUDIO="$DTOPEN_VAUDIO"
fi

if [ -z "$DTOPEN_VPS" ]
then
    VPS="papers evince okular gv mgv"
else
    VPS="$DTOPEN_VPS"
fi

if [ -z "$DTOPEN_VPDF" ]
then
    VPDF="papers evince okular zathura qpdfview mupdf ck-browser xpdf"
else
    VPDF="$DTOPEN_VPDF"
fi

if [ -z "$DTOPEN_VOFFICE" ]
then
    VOFFICE="libreoffice soffice abiword gnumeric"
else
    VOFFICE="$DTOPEN_VOFFICE"
fi

FindProg()
{
    whence "$1" 2>/dev/null
    return 0
}

ErrorMsg()
{
    if [ -z "$3" ]
    then
        OKM="OK"
    else
        OKM="$3"
    fi
    CDE_INSTALLATION_TOP/bin/dterror.ds "$2" "$1" "$OKM"
    return 0
}

TryXdgMimeOpen()
{
    if [ $# -gt 0 ] && [ -x "$DTAPPINT_XDG" ]
    then
        "$DTAPPINT_XDG" --open-mime "$@"
        rc=$?
        if [ $rc -eq 0 ]
        then
            exit 0
        fi
    fi
    return 1
}

DoSimpleCmd()
{
    cmds="$1"
    shift

    for i in $cmds
    do
        thecmd="$(FindProg "$i")"
        if [ -n "$thecmd" ]
        then
            "$thecmd" "$@"
            return 0
        fi
    done

    xdgcmd="$(FindProg xdg-open)"
    if [ -n "$xdgcmd" ] && [ $# -gt 0 ]
    then
        "$xdgcmd" "$1"
        return 0
    fi

    ErrorMsg "Helper not found" \
             "${DTOPEN}: Could not find any installed application or XDG handler\nfor this file:\n\n$cmds"
    return 0
}

COMMANDS="dtopen dtopen_any dtopen_image dtopen_pdf dtopen_ps dtopen_video dtopen_audio dtopen_office"

case $APPNAME in
    dtopen_image)
        if [ -z "$DTOPEN_VIMAGE" ]; then TryXdgMimeOpen "$@"; fi
        DoSimpleCmd "$VIMAGE" "$@"
        ;;
    dtopen_pdf)
        if [ -z "$DTOPEN_VPDF" ]; then TryXdgMimeOpen "$@"; fi
        DoSimpleCmd "$VPDF" "$@"
        ;;
    dtopen_ps)
        if [ -z "$DTOPEN_VPS" ]; then TryXdgMimeOpen "$@"; fi
        DoSimpleCmd "$VPS" "$@"
        ;;
    dtopen_video)
        if [ -z "$DTOPEN_VVIDEO" ]; then TryXdgMimeOpen "$@"; fi
        DoSimpleCmd "$VVIDEO" "$@"
        ;;
    dtopen_audio)
        if [ -z "$DTOPEN_VAUDIO" ]; then TryXdgMimeOpen "$@"; fi
        DoSimpleCmd "$VAUDIO" "$@"
        ;;
    dtopen_office)
        if [ -z "$DTOPEN_VOFFICE" ]; then TryXdgMimeOpen "$@"; fi
        DoSimpleCmd "$VOFFICE" "$@"
        ;;
    dtopen|dtopen_any)
        TryXdgMimeOpen "$@"
        DoSimpleCmd "xdg-open ck-browser dtpad" "$@"
        ;;
    *)
        ErrorMsg "${DTOPEN}: Unknown Helper Application" \
                  "\"$APPNAME\" is not a recognized Helper Application.\nKnown Helper Applications are:\n\n$COMMANDS"
        ;;
esac

exit 0
