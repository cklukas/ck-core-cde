ACTION Passwd
{
        LABEL           %|nls-25033-#Change Password#|
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     dtterm -geometry 60x8 -xrm "*menuBar: False" -e sh -c ' \
                               echo "%|nls-25034-#Changeing#|"; \
                               echo "%|nls-25035-#---------#|"; \
                               passwd'
        DESCRIPTION     %|nls-25036-#The#|
}

XCOMM #####
XCOMM CK Core Workstation & Laptop System Status Actions
XCOMM #####

ACTION CkStatus
{
        LABEL           System Status
        ICON            Fpstatus
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-status --tab overview
        DESCRIPTION     Open the CK Core System Status, Notifications, and Tray console.
}

ACTION CkNotify
{
        LABEL           Notifications & Tray
        ICON            Fpnotif
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-status --tab notifications
        DESCRIPTION     Open Desktop Notifications and StatusNotifier System Tray.
}

ACTION CkPower
{
        LABEL           Power & Battery
        ICON            Fppower
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-status --tab power
        DESCRIPTION     Open Laptop Battery and Workstation Power Status.
}

ACTION CkNetwork
{
        LABEL           Network & Wi-Fi
        ICON            Fpnet
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-status --tab network
        DESCRIPTION     Open Network, IPv4/IPv6, and Wi-Fi Status.
}

ACTION CkBluetooth
{
        LABEL           Bluetooth
        ICON            Fpbt
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-status --tab bluetooth
        DESCRIPTION     Open Bluetooth Adapter and Device Controls.
}

ACTION CkMixer
{
        LABEL           Audio Mixer
        ICON            Dtaudio
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-mixer
        DESCRIPTION     Open the CK Core Audio Volume Mixer.
}

ACTION CkSound
{
        LABEL           Sound & MIDI
        ICON            Fpsound
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-sound
        DESCRIPTION     Open the CK Core Sound & MIDI Control Panel.
}

ACTION CkMidi
{
        LABEL           MIDI Player
        ICON            Fpmidi
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-midi
        DESCRIPTION     Open the CK Core General MIDI Player.
}

ACTION CkMidi
{
        LABEL           MIDI Player
        ICON            Fpmidi
        ARG_COUNT       >0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-midi "%(File)Arg_1%"
        DESCRIPTION     Play a Standard MIDI File in CK Core MIDI Player.
}

ACTION DtstyleDisplay
{
        LABEL           Monitors & Display
        ICON            Fpdisp
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     dtstyle -display_dialog
        DESCRIPTION     Open the Style Manager Display and Multi-Monitor Arrangement dialog.
}

ACTION DtstyleBackdrop
{
        LABEL           Backdrop Settings
        ICON            Fpstyle
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     dtstyle -backdrop
        DESCRIPTION     Open the Style Manager Backdrop dialog.
}

ACTION CkAdmin
{
        LABEL           System Administration
        ICON            Dtasys
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-admin
        DESCRIPTION     Open the CK Core System Administration panel (Default Applications, Date/Time & NTP, Firmware Updates).
}

ACTION CkAdminDefaultApps
{
        LABEL           Default Applications
        ICON            Dtasys
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-admin --tab default-apps
        DESCRIPTION     Configure XDG MIME default applications (Web Browser, Mail, File Manager, Editor, PDF, Image Viewer).
}

ACTION CkAdminDateTime
{
        LABEL           Date, Time & NTP
        ICON            Dtasys
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-admin --tab datetime
        DESCRIPTION     Configure system timezone and NTP synchronization via systemd-timedated.
}

ACTION CkAdminFirmware
{
        LABEL           Firmware Updates
        ICON            Dtasys
        ARG_COUNT       0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     ck-admin --tab firmware
        DESCRIPTION     Inspect hardware firmware versions and available updates via fwupd.
}

