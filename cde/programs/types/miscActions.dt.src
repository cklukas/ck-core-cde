ACTION Xcalc
{
        LABEL		%|nls-25001-#X Calculator#|
        ARG_COUNT	0
        TYPE            COMMAND
        WINDOW_TYPE     NO_STDIO
        EXEC_STRING     xcalc
	DESCRIPTION	%|nls-25002-#The#|
}

