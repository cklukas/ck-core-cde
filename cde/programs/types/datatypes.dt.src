XCOMM #######################################################

DATA_ATTRIBUTES MSDOS_EXE
{
        ACTIONS         (None)
        ICON            Dtexec
        IS_EXECUTABLE   true
        NAME_TEMPLATE	%s.exe
        MIME_TYPE	application/octet-stream
        SUNV3_TYPE	msdos-file
        DESCRIPTION     %|nls-3029-#This is#|
        TYPE_LABEL      %|nls-31012-#MSDOS_EXE#|
}
DATA_CRITERIA MSDOS_EXE1
{
        DATA_ATTRIBUTES_NAME MSDOS_EXE
        MODE            f&x
        NAME_PATTERN    *.exe
}
DATA_CRITERIA MSDOS_EXE2
{
        DATA_ATTRIBUTES_NAME MSDOS_EXE
        MODE            f&x
        NAME_PATTERN    *.EXE
}
ACTION Print
{
        LABEL           %|nls-2-Print|
        ARG_TYPE        MSDOS_EXE
        TYPE            MAP
        MAP_ACTION	NoPrint
}

XCOMM #####################################################################
XCOMM ## PDF

DATA_ATTRIBUTES PDF
{
	ACTIONS			Open,Print
	ICON			acroread
	NAME_TEMPLATE	%s.pdf
	MIME_TYPE		application/pdf
	DESCRIPTION		This file contains pdf data. Its data type \
					is named PDF.  PDF files have names ending with '.pdf' \
					or '.PDF', or contain the characters "%PDF".
	TYPE_LABEL		PDF
}
DATA_CRITERIA PDF1
{
	DATA_ATTRIBUTES_NAME PDF
	MODE			f&!x
	NAME_PATTERN	*.pdf
}
DATA_CRITERIA PDF2
{
	DATA_ATTRIBUTES_NAME PDF
	MODE			f&!x
	NAME_PATTERN	*.PDF
}
DATA_CRITERIA PDF3
{
	DATA_ATTRIBUTES_NAME	PDF
	CONTENT 		0 string %PDF
	MODE			f&!x
}
ACTION Open
{
	LABEL			Open
	ARG_TYPE		PDF
	TYPE			MAP
	MAP_ACTION		DisplayPDF
}
ACTION Print
{
	LABEL			Print
	ARG_TYPE		PDF
	TYPE			MAP
	MAP_ACTION		DisplayPDF
}

XCOMM #######################################################################
XCOMM ## Modern XDG Image, Video, Audio & Office Formats (WP-12)

DATA_ATTRIBUTES WEBP
{
	ACTIONS         Open
	ICON            Dtimage
	NAME_TEMPLATE   %s.webp
	MIME_TYPE       image/webp
	DESCRIPTION     WebP raster image file.
	TYPE_LABEL      WEBP
}
DATA_CRITERIA WEBP1
{
	DATA_ATTRIBUTES_NAME WEBP
	MODE            f
	NAME_PATTERN    *.webp
}
DATA_CRITERIA WEBP2
{
	DATA_ATTRIBUTES_NAME WEBP
	MODE            f
	NAME_PATTERN    *.WEBP
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        WEBP
	TYPE            MAP
	MAP_ACTION      DisplayImage
}

DATA_ATTRIBUTES SVG
{
	ACTIONS         Open
	ICON            Dtimage
	NAME_TEMPLATE   %s.svg
	MIME_TYPE       image/svg+xml
	DESCRIPTION     Scalable Vector Graphics (SVG) image file.
	TYPE_LABEL      SVG
}
DATA_CRITERIA SVG1
{
	DATA_ATTRIBUTES_NAME SVG
	MODE            f
	NAME_PATTERN    *.svg
}
DATA_CRITERIA SVG2
{
	DATA_ATTRIBUTES_NAME SVG
	MODE            f
	NAME_PATTERN    *.SVG
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        SVG
	TYPE            MAP
	MAP_ACTION      DisplayImage
}

DATA_ATTRIBUTES VIDEO_MODERN
{
	ACTIONS         Open
	ICON            Dtmpg
	MIME_TYPE       video/mp4
	DESCRIPTION     Modern digital video file (MP4, MKV, WebM, MOV).
	TYPE_LABEL      VIDEO
}
DATA_CRITERIA VIDEO_MODERN1
{
	DATA_ATTRIBUTES_NAME VIDEO_MODERN
	MODE            f
	NAME_PATTERN    *.mp4
}
DATA_CRITERIA VIDEO_MODERN2
{
	DATA_ATTRIBUTES_NAME VIDEO_MODERN
	MODE            f
	NAME_PATTERN    *.mkv
}
DATA_CRITERIA VIDEO_MODERN3
{
	DATA_ATTRIBUTES_NAME VIDEO_MODERN
	MODE            f
	NAME_PATTERN    *.webm
}
DATA_CRITERIA VIDEO_MODERN4
{
	DATA_ATTRIBUTES_NAME VIDEO_MODERN
	MODE            f
	NAME_PATTERN    *.mov
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        VIDEO_MODERN
	TYPE            MAP
	MAP_ACTION      DisplayVideo
}

ACTION DisplayAudio
{
	LABEL           Audio Player
	TYPE            COMMAND
	ICON            Dtaudio
	WINDOW_TYPE     NO_STDIO
	ARG_COUNT       >0
	EXEC_STRING     dtopen_audio %(File)Args%
}
DATA_ATTRIBUTES AUDIO_MODERN
{
	ACTIONS         Open
	ICON            Dtaudio
	MIME_TYPE       audio/mpeg
	DESCRIPTION     Digital audio file (MP3, FLAC, OGG, M4A).
	TYPE_LABEL      AUDIO
}
DATA_CRITERIA AUDIO_MODERN1
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.mp3
}
DATA_CRITERIA AUDIO_MODERN2
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.flac
}
DATA_CRITERIA AUDIO_MODERN3
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.ogg
}
DATA_CRITERIA AUDIO_MODERN4
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.m4a
}
DATA_CRITERIA AUDIO_MODERN5
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.opus
}
DATA_CRITERIA AUDIO_MODERN6
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.aac
}
DATA_CRITERIA AUDIO_MODERN7
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.aiff
}
DATA_CRITERIA AUDIO_MODERN8
{
	DATA_ATTRIBUTES_NAME AUDIO_MODERN
	MODE            f
	NAME_PATTERN    *.aif
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        AUDIO_MODERN
	TYPE            MAP
	MAP_ACTION      DisplayAudio
}

DATA_ATTRIBUTES AUDIO_PLAYLIST
{
	ACTIONS         Open
	ICON            Dtaudio
	MIME_TYPE       audio/x-mpegurl
	DESCRIPTION     Audio playlist file (M3U / M3U8 / PLS).
	TYPE_LABEL      PLAYLIST
}
DATA_CRITERIA AUDIO_PLAYLIST1
{
	DATA_ATTRIBUTES_NAME AUDIO_PLAYLIST
	MODE            f
	NAME_PATTERN    *.m3u
}
DATA_CRITERIA AUDIO_PLAYLIST2
{
	DATA_ATTRIBUTES_NAME AUDIO_PLAYLIST
	MODE            f
	NAME_PATTERN    *.m3u8
}
DATA_CRITERIA AUDIO_PLAYLIST3
{
	DATA_ATTRIBUTES_NAME AUDIO_PLAYLIST
	MODE            f
	NAME_PATTERN    *.pls
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        AUDIO_PLAYLIST
	TYPE            MAP
	MAP_ACTION      DisplayAudio
}

ACTION PlayMidi
{
	LABEL           MIDI Player
	TYPE            COMMAND
	ICON            Fpmidi
	WINDOW_TYPE     NO_STDIO
	ARG_COUNT       >0
	EXEC_STRING     dtopen_midi %(File)Args%
	DESCRIPTION     Play a Standard MIDI File (.mid, .midi, .kar, .rmi).
}
DATA_ATTRIBUTES AUDIO_MIDI
{
	ACTIONS         Open,Play
	ICON            Dtmidi
	NAME_TEMPLATE   %s.mid
	MIME_TYPE       audio/midi
	DESCRIPTION     Standard MIDI File (SMF / RMID / Karaoke) music sequence.
	TYPE_LABEL      MIDI
}
DATA_CRITERIA AUDIO_MIDI1
{
	DATA_ATTRIBUTES_NAME AUDIO_MIDI
	MODE            f
	NAME_PATTERN    *.mid
}
DATA_CRITERIA AUDIO_MIDI2
{
	DATA_ATTRIBUTES_NAME AUDIO_MIDI
	MODE            f
	NAME_PATTERN    *.MID
}
DATA_CRITERIA AUDIO_MIDI3
{
	DATA_ATTRIBUTES_NAME AUDIO_MIDI
	MODE            f
	NAME_PATTERN    *.midi
}
DATA_CRITERIA AUDIO_MIDI4
{
	DATA_ATTRIBUTES_NAME AUDIO_MIDI
	MODE            f
	NAME_PATTERN    *.MIDI
}
DATA_CRITERIA AUDIO_MIDI5
{
	DATA_ATTRIBUTES_NAME AUDIO_MIDI
	MODE            f
	NAME_PATTERN    *.kar
}
DATA_CRITERIA AUDIO_MIDI6
{
	DATA_ATTRIBUTES_NAME AUDIO_MIDI
	MODE            f
	NAME_PATTERN    *.rmi
}
DATA_CRITERIA AUDIO_MIDI7
{
	DATA_ATTRIBUTES_NAME AUDIO_MIDI
	MODE            f
	CONTENT         0 string MThd
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        AUDIO_MIDI
	TYPE            MAP
	MAP_ACTION      PlayMidi
}
ACTION Play
{
	LABEL           %|nls-3012-Play|
	ARG_TYPE        AUDIO_MIDI
	TYPE            MAP
	MAP_ACTION      PlayMidi
}
ACTION Print
{
	LABEL           %|nls-2-Print|
	ARG_TYPE        AUDIO_MIDI
	TYPE            MAP
	MAP_ACTION      NoPrint
}

ACTION DisplayOffice
{
	LABEL           Office Document Viewer
	TYPE            COMMAND
	ICON            Dtpenpd
	WINDOW_TYPE     NO_STDIO
	ARG_COUNT       >0
	EXEC_STRING     dtopen_office %(File)Args%
}
DATA_ATTRIBUTES OFFICE_DOC
{
	ACTIONS         Open
	ICON            Dtpenpd
	MIME_TYPE       application/vnd.oasis.opendocument.text
	DESCRIPTION     OpenDocument / Office Open XML document, spreadsheet, or presentation.
	TYPE_LABEL      OFFICE_DOC
}
DATA_CRITERIA OFFICE_DOC1
{
	DATA_ATTRIBUTES_NAME OFFICE_DOC
	MODE            f
	NAME_PATTERN    *.odt
}
DATA_CRITERIA OFFICE_DOC2
{
	DATA_ATTRIBUTES_NAME OFFICE_DOC
	MODE            f
	NAME_PATTERN    *.ods
}
DATA_CRITERIA OFFICE_DOC3
{
	DATA_ATTRIBUTES_NAME OFFICE_DOC
	MODE            f
	NAME_PATTERN    *.odp
}
DATA_CRITERIA OFFICE_DOC4
{
	DATA_ATTRIBUTES_NAME OFFICE_DOC
	MODE            f
	NAME_PATTERN    *.docx
}
DATA_CRITERIA OFFICE_DOC5
{
	DATA_ATTRIBUTES_NAME OFFICE_DOC
	MODE            f
	NAME_PATTERN    *.xlsx
}
DATA_CRITERIA OFFICE_DOC6
{
	DATA_ATTRIBUTES_NAME OFFICE_DOC
	MODE            f
	NAME_PATTERN    *.pptx
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        OFFICE_DOC
	TYPE            MAP
	MAP_ACTION      DisplayOffice
}

XCOMM #######################################################################
XCOMM ## Native CK-Core Image Viewer (ck-view), PDF Viewer (ck-pdf) & iCalendar (WP-19)

ACTION CkView
{
	LABEL           Image Viewer (ck-view)
	TYPE            COMMAND
	ICON            Dtimage
	WINDOW_TYPE     NO_STDIO
	EXEC_STRING     ck-view "%(File)Arg_1%"
	DESCRIPTION     Open an image in the native Motif Image Viewer (ck-view).
}

ACTION CkPdf
{
	LABEL           PDF Viewer (ck-pdf)
	TYPE            COMMAND
	ICON            acroread
	WINDOW_TYPE     NO_STDIO
	EXEC_STRING     ck-pdf "%(File)Arg_1%"
	DESCRIPTION     Open a PDF document in the native Motif PDF Viewer (ck-pdf).
}

DATA_ATTRIBUTES ICALENDAR
{
	ACTIONS         Open
	ICON            Dtcm
	NAME_TEMPLATE   %s.ics
	MIME_TYPE       text/calendar
	DESCRIPTION     RFC 5545 iCalendar (.ics) schedule file.
	TYPE_LABEL      ICALENDAR
}
DATA_CRITERIA ICALENDAR1
{
	DATA_ATTRIBUTES_NAME ICALENDAR
	MODE            f
	NAME_PATTERN    *.ics
}
DATA_CRITERIA ICALENDAR2
{
	DATA_ATTRIBUTES_NAME ICALENDAR
	MODE            f
	NAME_PATTERN    *.ICS
}
ACTION Open
{
	LABEL           %|nls-1-Open|
	ARG_TYPE        ICALENDAR
	TYPE            COMMAND
	WINDOW_TYPE     NO_STDIO
	EXEC_STRING     dtcm
}

XCOMM ######################## EOF ############################################
