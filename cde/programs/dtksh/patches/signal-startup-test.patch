-	float s
+	# Measure from the first command in the child to its return, so loading
+	# the interpreter and its shared libraries is outside the trap deadline.
+	stamp='printf "%(%s.%N)T\n" now > "$tmp/signal-start"; '
+	check_time()
+	{
+		float started elapsed
+		if	read -r started < "$tmp/signal-start"
+		then	(( elapsed = $(printf '%(%s.%N)T' now) - started ))
+			(( elapsed >= 0 && elapsed <= .35 )) || print "\\err_exit $1 'took $elapsed seconds, expected around .2'"
+		else	print "\\err_exit $1 'missing signal start time'"
+		fi
+		rm -f "$tmp/signal-start"
+	}
 	redirect > parallel_3.err
 
