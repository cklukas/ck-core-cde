def is_valid_pkg_token(name: str) -> bool:
    return bool(re.match(r"^[A-Za-z0-9][A-Za-z0-9.+_-]{0,126}$", name or ""))


def parse_xpm_color_spec(spec: str) -> tuple[int, int, int] | None:
    if re.search(r"\b(?:c|s|m)\s+none\b", spec, flags=re.IGNORECASE):
        return None
    m_hex = re.search(r"#([0-9A-Fa-f]{12}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})\b", spec)
    if m_hex:
        hx = m_hex.group(1)
        if len(hx) == 12:
            return (int(hx[0:2], 16), int(hx[4:6], 16), int(hx[8:10], 16))
        if len(hx) == 6:
            return (int(hx[0:2], 16), int(hx[2:4], 16), int(hx[4:6], 16))
        if len(hx) == 3:
            return (int(hx[0] * 2, 16), int(hx[1] * 2, 16), int(hx[2] * 2, 16))
    m_col = re.search(r"\bc\s+([A-Za-z0-9_]+)", spec)
    if m_col:
        cname = m_col.group(1).lower()
        if cname == "none":
            return None
        if cname in NAMED_X11_COLORS:
            return NAMED_X11_COLORS[cname]
        m_g = re.match(r"^gr[ae]y(\d+)$", cname)
        if m_g:
            gv = max(0, min(255, int(int(m_g.group(1)) * 255 / 100)))
            return (gv, gv, gv)
    return (148, 148, 148)


def render_gray_install_badge_xpm(src_pm: Path | None, dst_pm: Path, fallback_size: int) -> bool:
    width = fallback_size
    height = fallback_size
    grid: list[list[tuple[int, int, int] | None]] = []

    if src_pm and src_pm.is_file():
        try:
            raw = src_pm.read_text(encoding="latin-1", errors="replace")
            # Strip C block comments before extracting XPM string literals
            no_comments = re.sub(r"/\*.*?\*/", "", raw, flags=re.DOTALL)
            strs = [m.group(1) for m in re.finditer(r'"((?:[^"\\]|\\.)*)"', no_comments)]
            if strs:
                hdr = strs[0].split()
                w, h, ncolors, cpp = int(hdr[0]), int(hdr[1]), int(hdr[2]), int(hdr[3])
                if 8 <= w <= 128 and 8 <= h <= 128 and 1 <= ncolors <= 4096 and 1 <= cpp <= 4:
                    cmap: dict[str, tuple[int, int, int] | None] = {}
                    for ci in range(ncolors):
                        entry = strs[1 + ci]
                        key = entry[:cpp]
                        cmap[key] = parse_xpm_color_spec(entry[cpp:])
                    rows = strs[1 + ncolors : 1 + ncolors + h]
                    if len(rows) == h:
                        width, height = w, h
                        for row_s in rows:
                            prow: list[tuple[int, int, int] | None] = []
                            for x in range(w):
                                k = row_s[x * cpp : (x + 1) * cpp]
                                rgb = cmap.get(k)
                                if rgb is None:
                                    prow.append(None)
                                else:
                                    r, g, b = rgb
                                    lum = 0.299 * r + 0.587 * g + 0.114 * b
                                    # Softened grayscale quantized to 24 clean steps
                                    gray = int(round((lum * 0.62 + 154.0 * 0.38) / 10.0) * 10)
                                    gray = max(36, min(236, gray))
                                    prow.append((gray, gray, gray))
                            grid.append(prow)
        except Exception:
            grid = []

    if not grid:
        width = height = fallback_size
        for y in range(height):
            prow = []
            for x in range(width):
                margin = max(2, width // 8)
                if margin <= x < width - margin and margin <= y < height - margin:
                    prow.append((168, 168, 168))
                else:
                    prow.append(None)
            grid.append(prow)

    # Overlay downward-facing royal-blue download arrow badge at bottom-right
    badge = BADGE_48 if width >= 40 else (BADGE_32 if width >= 24 else BADGE_16)
    badge_colors: dict[str, tuple[int, int, int]] = {
        "W": (255, 255, 255),
        "N": (8, 32, 84),
        "H": (107, 182, 255),
        "B": (24, 100, 216),
    }
    bh = len(badge)
    bw = len(badge[0])
    ox = max(0, width - bw)
    oy = max(0, height - bh)
    for by, brow in enumerate(badge):
        ty = oy + by
        if ty >= height:
            break
        for bx, ch in enumerate(brow):
            tx = ox + bx
            if tx >= width or ch == ".":
                continue
            grid[ty][tx] = badge_colors[ch]

    # Encode compact 1-char XPM (<= 36 total colors)
    palette_chars = " .+@#$%&*=-;>,')!~{]^/(_:<[}|1234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
    used_colors: list[tuple[int, int, int] | None] = [None]
    color_to_char: dict[tuple[int, int, int] | None, str] = {None: " "}
    for prow in grid:
        for px in prow:
            if px not in color_to_char:
                idx = len(used_colors)
                ch = palette_chars[min(idx, len(palette_chars) - 1)]
                used_colors.append(px)
                color_to_char[px] = ch

    lines = [
        "/* XPM */",
        f"static char * {re.sub(r'[^A-Za-z0-9_]', '_', dst_pm.stem)}_xpm[] = {{",
        f'"{width} {height} {len(used_colors)} 1",',
    ]
    for col in used_colors:
        ch = color_to_char[col]
        if col is None:
            lines.append(f'"{ch}\tc None",')
        else:
            lines.append(f'"{ch}\tc #{col[0]:02x}{col[1]:02x}{col[2]:02x}",')
    for ri, prow in enumerate(grid):
        row_chars = "".join(color_to_char[px] for px in prow)
        comma = "," if ri + 1 < height else "};"
        lines.append(f'"{row_chars}"{comma}')

    dst_pm.parent.mkdir(parents=True, exist_ok=True)
    tmp_pm = dst_pm.parent / f".{dst_pm.name}.{os.getpid()}.tmp"
    tmp_pm.write_text("\n".join(lines) + "\n", encoding="ascii")
    os.replace(tmp_pm, dst_pm)
    return True


def find_system_cde_icon_pm(icon_name: str, sz: str) -> Path | None:
    search_dirs = [
        Path("/usr/dt/appconfig/icons/C"),
        Path("/etc/dt/appconfig/icons/C"),
    ]
    for cand_icon in (icon_name, "Dtadskt"):
        if not cand_icon:
            continue
        for sdir in search_dirs:
            pm = sdir / f"{cand_icon}.{sz}.pm"
            if pm.is_file():
                return pm
            # Fallback across sizes if an app only ships .m.pm or .l.pm
            for alt_sz in ("l", "m", "t"):
                alt_pm = sdir / f"{cand_icon}.{alt_sz}.pm"
                if alt_pm.is_file():
                    return alt_pm
    return None


def ensure_gray_badge_icon_set(orig_icon: str, icons_dir: Path, slug: str) -> str:
    badge_base = f"ckavail_{slug}"
    size_px = {"l": 48, "m": 32, "t": 16}
    for sz, px in size_px.items():
        dst = icons_dir / f"{badge_base}.{sz}.pm"
        src = find_system_cde_icon_pm(orig_icon, sz)
        need_regen = not dst.is_file()
        if not need_regen and src and src.is_file():
            try:
                need_regen = dst.stat().st_mtime < src.stat().st_mtime
            except OSError:
                need_regen = True
        if need_regen:
            render_gray_install_badge_xpm(src, dst, px)
    return badge_base


def parse_system_dt_actions() -> dict[str, dict[str, str]]:
    actions: dict[str, dict[str, str]] = {}
    override_types = os.environ.get("CK_SYS_TYPES_DIR", "").strip()
    types_dirs = (
        [Path(override_types)]
        if override_types
        else [Path("/etc/dt/appconfig/types/C"), Path("/usr/dt/appconfig/types/C")]
    )
    for tdir in types_dirs:
        if not tdir.is_dir():
            continue
        for dt_file in sorted(tdir.glob("*.dt")):
            try:
                text = dt_file.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            cur_name = ""
            brace_depth = 0
            fields: dict[str, str] = {}
            for raw in text.splitlines():
                line = raw.strip()
                if not line or line.startswith(("#", "!")):
                    continue
                if not cur_name:
                    m_act = re.match(r"^ACTION\s+([^\s{]+)\s*(\{)?", line)
                    if m_act:
                        cur_name = m_act.group(1)
                        brace_depth = 1 if m_act.group(2) else 0
                        fields = {}
                    continue
                brace_depth += line.count("{") - line.count("}")
                m_kv = re.match(r"^([A-Z0-9_]+)\s+(.*)$", line)
                if m_kv and m_kv.group(1) not in fields:
                    fields[m_kv.group(1)] = m_kv.group(2).strip()
                if brace_depth <= 0 and "}" in line:
                    if cur_name not in actions and fields.get("EXEC_STRING"):
                        actions[cur_name] = fields
                    cur_name = ""
                    brace_depth = 0
    return actions


def extract_primary_exec_prog(exec_str: str) -> str:
    if not exec_str:
        return ""
    cleaned = re.sub(r'"?%\([^)]*\)[^%]*%"?|%[A-Za-z0-9_]+%', "", exec_str).strip()
    try:
        toks = shlex.split(cleaned)
    except ValueError:
        toks = cleaned.split()
    idx = 0
    while idx < len(toks) and (toks[idx] == "env" or "=" in toks[idx]):
        idx += 1
    if idx >= len(toks):
        return ""
    return toks[idx]


def detect_pkg_backend() -> str:
    override = os.environ.get("CK_PKG_BACKEND", "").strip().lower()
    if override in ("apt", "dnf", "yum", "pacman", "zypper", "apk", "pkg", "none"):
        return override
    if which_prog("apt-cache") and which_prog("apt-get"):
        return "apt"
    for tool in ("dnf", "yum", "zypper", "pacman", "apk", "pkg"):
        if which_prog(tool):
            return tool
    return "none"


def batch_query_available_packages(candidates: set[str]) -> set[str]:
    valid = sorted(c for c in candidates if is_valid_pkg_token(c))
    if not valid:
        return set()

    mock_dir = os.environ.get("CK_PKG_MOCK_DIR", "").strip()
    if mock_dir:
        mdir = Path(mock_dir)
        return {c for c in valid if (mdir / c).is_file()}

    backend = detect_pkg_backend()
    if backend == "none":
        return set()

    env = {**os.environ, "LC_ALL": "C"}
    available: set[str] = set()

    if backend == "apt":
        try:
            cp = subprocess.run(
                ["apt-cache", "policy", "--", *valid],
                capture_output=True, text=True, env=env, timeout=8.0, check=False,
            )
            cur_pkg = ""
            for raw in cp.stdout.splitlines():
                if raw and not raw[0].isspace() and raw.endswith(":"):
                    cur_pkg = raw[:-1].strip()
                elif cur_pkg:
                    s = raw.strip()
                    if s.startswith("Candidate:"):
                        cand = s.split(":", 1)[1].strip()
                        if cand and cand != "(none)":
                            available.add(cur_pkg)
        except Exception:
            pass
        return available

    if backend in ("dnf", "yum"):
        try:
            cp = subprocess.run(
                [backend, "list", "-q", "--", *valid],
                capture_output=True, text=True, env=env, timeout=12.0, check=False,
            )
            valid_set = set(valid)
            for raw in cp.stdout.splitlines():
                tok = raw.strip().split()[0] if raw.strip() else ""
                base = tok.rsplit(".", 1)[0]
                if tok in valid_set:
                    available.add(tok)
                elif base in valid_set:
                    available.add(base)
        except Exception:
            pass
        return available

    for pkg in valid:
        cmd: list[str] = []
        if backend == "pacman":
            cmd = ["pacman", "-Si", "--", pkg]
        elif backend == "zypper":
            cmd = ["zypper", "--non-interactive", "info", "--", pkg]
        elif backend == "apk":
            cmd = ["apk", "search", "-e", pkg]
        elif backend == "pkg":
            cmd = ["pkg", "rquery", "%n", pkg]
        if not cmd:
            continue
        try:
            cp = subprocess.run(cmd, capture_output=True, text=True, env=env, timeout=4.0, check=False)
            if cp.returncode == 0 and cp.stdout.strip() and "not found" not in cp.stdout.lower():
                available.add(pkg)
        except Exception:
            pass
    return available


def sync_curated_appmanager_groups(
    appman_dir: Path,
    icons_dir: Path,
    dt_lines: list[str],
) -> tuple[list[str], list[str]]:
    sys_actions = parse_system_dt_actions()
    sys_appman_root = Path(os.environ.get("CK_SYS_APPMANAGER_DIR") or "/usr/dt/appconfig/appmanager/C")
    if not sys_appman_root.is_dir():
        return [], []

    # First pass: inspect all curated entries and collect uninstalled package candidates
    group_items: dict[str, list[tuple[str, dict[str, str], str]]] = {}
    needed_pkgs: set[str] = set()

    for group in CURATED_APPMAN_GROUPS:
        src_group = sys_appman_root / group
        if not src_group.is_dir():
            continue
        items: list[tuple[str, dict[str, str], str]] = []
        for entry in sorted(src_group.iterdir()):
            if entry.name.startswith(".") or entry.is_dir():
                continue
            act_name = entry.name
            meta = sys_actions.get(act_name, {})
            exec_prog = extract_primary_exec_prog(meta.get("EXEC_STRING", "")) or act_name

            installed_bin = which_prog(exec_prog)
            if not installed_bin and act_name in EXEC_BINARY_ALIASES:
                for alt_bin in EXEC_BINARY_ALIASES[act_name]:
                    installed_bin = which_prog(alt_bin)
                    if installed_bin:
                        exec_prog = alt_bin
                        break

            if installed_bin:
                items.append((act_name, meta, f"INSTALLED:{exec_prog}"))
            else:
                cands = list(PKG_CANDIDATE_ALIASES.get(act_name, ()))
                for fallback in (act_name, act_name.lower(), Path(exec_prog).name, Path(exec_prog).name.lower()):
                    if is_valid_pkg_token(fallback) and fallback not in cands:
                        cands.append(fallback)
                needed_pkgs.update(cands)
                items.append((act_name, meta, "CHECK:" + ",".join(cands)))
        group_items[group] = items

    avail_pkgs = batch_query_available_packages(needed_pkgs)

    populated_groups: list[str] = []
    empty_groups: list[str] = []

    for group in CURATED_APPMAN_GROUPS:
        items = group_items.get(group, [])
        dst_group = appman_dir / group
        keep_names: set[str] = set()

        for act_name, meta, status in items:
            if status.startswith("INSTALLED:"):
                resolved_prog = status.split(":", 1)[1]
                orig_prog = extract_primary_exec_prog(meta.get("EXEC_STRING", ""))
                # If an alternate binary name matched (e.g. 'chromium' vs 'chromium-browser'), emit an override
                if orig_prog and resolved_prog != orig_prog:
                    label = sanitize_dt_str(meta.get("LABEL", act_name))
                    icon = sanitize_dt_str(meta.get("ICON", "Dtadskt"))
                    desc = sanitize_dt_str(meta.get("DESCRIPTION", label))
                    dt_lines.extend([
                        f"ACTION {act_name}",
                        "{",
                        f"    LABEL       {label}",
                        "    TYPE        COMMAND",
                        f"    ICON        {icon}",
                        "    WINDOW_TYPE NO_STDIO",
                        f"    EXEC_STRING {resolved_prog}",
                        f"    DESCRIPTION {desc}",
                        "}",
                        "",
                    ])
                dst_group.mkdir(parents=True, exist_ok=True)
                stub = dst_group / act_name
                if not stub.exists():
                    stub.write_text("", encoding="utf-8")
                os.chmod(stub, 0o755)
                keep_names.add(act_name)
                continue

            cands = [c for c in status.split(":", 1)[1].split(",") if c]
            matched_pkg = next((c for c in cands if c in avail_pkgs), "")
            if not matched_pkg:
                # Neither installed nor available in package registry (e.g. skype, nxclient) -> hide!
                continue

            slug = re.sub(r"[^A-Za-z0-9_]+", "_", act_name).strip("_").lower() or "app"
            orig_icon = sanitize_dt_str(meta.get("ICON", "Dtadskt"))
            badge_icon = ensure_gray_badge_icon_set(orig_icon, icons_dir, slug)
            label = sanitize_dt_str(meta.get("LABEL", act_name))
            exec_prog = extract_primary_exec_prog(meta.get("EXEC_STRING", "")) or matched_pkg
            pkg_spec = ",".join(cands)
            install_cmd = (
                f"ck-pkg-install --pkg {shlex.quote(pkg_spec)} "
                f"--label {shlex.quote(label)} --exec {shlex.quote(exec_prog)}"
            )
            desc = sanitize_dt_str(
                f"{label} (Not installed - double-click to download and install '{matched_pkg}')"
            )
            dt_lines.extend([
                f"ACTION {act_name}",
                "{",
                f"    LABEL       {label}",
                "    TYPE        COMMAND",
                f"    ICON        {badge_icon}",
                "    WINDOW_TYPE NO_STDIO",
                f"    EXEC_STRING {install_cmd}",
                f"    DESCRIPTION {desc}",
                "}",
                "",
            ])
            dst_group.mkdir(parents=True, exist_ok=True)
            stub = dst_group / act_name
            if not stub.exists():
                stub.write_text("", encoding="utf-8")
            os.chmod(stub, 0o755)
            keep_names.add(act_name)

        if dst_group.is_dir():
            for child in list(dst_group.iterdir()):
                if child.name not in keep_names:
                    try:
                        child.unlink()
                    except OSError:
                        pass
            if not any(dst_group.iterdir()):
                try:
                    dst_group.rmdir()
                except OSError:
                    pass

        if dst_group.is_dir() and keep_names:
            populated_groups.append(group)
        else:
            empty_groups.append(group)

    return populated_groups, empty_groups


def sync_appmanager_session_links(
    home: Path,
    managed_folders: list[str],
    prune_folders: list[str] | None = None,
) -> None:
    appman_root = Path("/var/dt/appconfig/appmanager")
    if not appman_root.is_dir():
        return
    uid = os.getuid()
    session_dirs: list[Path] = []
    env_sess = os.environ.get("DTUSERSESSION", "")
    if env_sess and "/" not in env_sess:
        cand = appman_root / env_sess
        if cand.is_dir():
            session_dirs.append(cand)
    else:
        try:
            real_pw_home = Path(pwd.getpwuid(uid).pw_dir).resolve()
            is_real_home = home.resolve() == real_pw_home
        except Exception:
            is_real_home = False
        if is_real_home:
            for child in appman_root.iterdir():
                try:
                    st = child.lstat()
                except OSError:
                    continue
                if child.is_dir() and not child.is_symlink() and st.st_uid == uid and child not in session_dirs:
                    session_dirs.append(child)

    for sdir in session_dirs:
        try:
            orig_mode = sdir.stat().st_mode & 0o777
            os.chmod(sdir, orig_mode | 0o200)
        except OSError:
            orig_mode = None
        for folder in managed_folders:
            target = home / ".dt" / "appmanager" / folder
            link = sdir / folder
            try:
                if target.is_dir():
                    if link.is_symlink():
                        if link.resolve() != target.resolve():
                            link.unlink()
                            link.symlink_to(target)
                    elif not link.exists():
                        link.symlink_to(target)
            except OSError:
                pass
        for folder in (prune_folders or []):
            link = sdir / folder
            try:
                if link.is_symlink():
                    link.unlink()
            except OSError:
                pass
        if orig_mode is not None:
            try:
                os.chmod(sdir, orig_mode)
            except OSError:
                pass


def run_index_once(trigger_reload: bool = True) -> int:
    home = Path(os.environ.get("HOME") or Path.home())
    dt_dir = home / ".dt"
    types_dir = dt_dir / "types"
    icons_dir = dt_dir / "icons"
    appman_dir = dt_dir / "appmanager"
    desktop_apps_dir = appman_dir / "Desktop_Apps"

    types_dir.mkdir(parents=True, exist_ok=True)
    icons_dir.mkdir(parents=True, exist_ok=True)
    appman_dir.mkdir(parents=True, exist_ok=True)

    entries = collect_all_desktop_entries(include_nodisplay=False)

    dt_lines: list[str] = [
        "# Auto-generated by dtappintegrate --xdg (CK-Core CDE WP-12).",
        "# Synchronizes XDG .desktop applications into CDE Application Manager.",
        "",
        "ACTION CkLaunch",
        "{",
        "    LABEL       Quick Launch",
        "    TYPE        COMMAND",
        "    ICON        Dtappmgr",
        "    WINDOW_TYPE NO_STDIO",
        "    EXEC_STRING ck-launch --toggle",
        "    DESCRIPTION Search XDG applications, open windows, CDE settings, and calculator expressions.",
        "}",
        "",
    ]

    store_cmd, store_label = discover_software_store_cmd()
    dt_lines.extend([
        "ACTION CkSoftwareCenter",
        "{",
        f"    LABEL       {sanitize_dt_str(store_label)}",
        "    TYPE        COMMAND",
        "    ICON        Dtadskt",
        "    WINDOW_TYPE NO_STDIO",
        f"    EXEC_STRING {store_cmd}",
        "    DESCRIPTION Browse and update Ubuntu packages and desktop applications.",
        "}",
        "",
    ])

    for folder, label, cde_icon, _ in CATEGORIES:
        attr = f"CK_{folder.upper()}_APPGROUP"
        dt_lines.extend([
            f"DATA_ATTRIBUTES {attr}",
            "{",
            "    ACTIONS         OpenInPlace,OpenNewView,Print",
            f"    ICON            {cde_icon}",
            f"    LABEL           {label}",
            "    MEDIA           FILE_NAME",
            "    MOVE_TO_ACTION  FILESYSTEM_MOVE",
            "    COPY_TO_ACTION  FILESYSTEM_COPY",
            "    LINK_TO_ACTION  FILESYSTEM_LINK",
            f"    DESCRIPTION     XDG {label} applications.",
            "}",
            f"DATA_CRITERIA {attr}_CRIT1",
            "{",
            f"    DATA_ATTRIBUTES_NAME {attr}",
            "    MODE            d",
            f"    PATH_PATTERN    */appmanager/*/{folder}",
            "}",
            f"DATA_CRITERIA {attr}_CRIT2",
            "{",
            f"    DATA_ATTRIBUTES_NAME {attr}",
            "    MODE            d",
            f"    PATH_PATTERN    */appmanager/{folder}",
            "}",
            "ACTION Open",
            "{",
            "    LABEL           Open",
            f"    ARG_TYPE        {attr}",
            "    TYPE            MAP",
            "    MAP_ACTION      OpenAppGroup",
            "}",
            "",
        ])

    active_stubs_by_folder: dict[str, set[str]] = {f: set() for f, _, _, _ in CATEGORIES}
    active_desktop_apps_stubs: set[str] = {"CkLaunch", "CkSoftwareCenter"}

    for did, entry in sorted(entries.items()):
        digest = hashlib.sha1(did.encode("utf-8")).hexdigest()[:8]
        stem_clean = re.sub(r"[^A-Za-z0-9_]+", "_", Path(did).stem).strip("_")[:32] or "App"
        slug = f"{stem_clean}_{digest}"
        act_name = f"CkXdg_{slug}"

        folder, _, fallback_icon = map_entry_category(entry)
        icon_name = resolve_icon_for_cde(entry["icon"], fallback_icon, icons_dir, slug)
        label = sanitize_dt_str(entry["name"]) or stem_clean
        desc = sanitize_dt_str(entry["comment"] or entry["generic_name"] or entry["name"])
        win_type = "PERM_TERMINAL" if entry["terminal"] else "NO_STDIO"
        cmd_no_args = expand_exec_for_cde_dt(entry, with_file_args=False)
        cmd_with_args = expand_exec_for_cde_dt(entry, with_file_args=True)

        dt_lines.extend([
            f"ACTION {act_name}",
            "{",
            f"    LABEL       {label}",
            "    TYPE        COMMAND",
            f"    ICON        {icon_name}",
            f"    WINDOW_TYPE {win_type}",
            "    ARG_COUNT   0",
            f"    EXEC_STRING {cmd_no_args}",
            f"    DESCRIPTION {desc}",
            "}",
            f"ACTION {act_name}",
            "{",
            f"    LABEL       {label}",
            "    TYPE        COMMAND",
            f"    ICON        {icon_name}",
            f"    WINDOW_TYPE {win_type}",
            "    ARG_COUNT   >0",
            f"    EXEC_STRING {cmd_with_args}",
            f"    DESCRIPTION {desc}",
            "}",
            "",
        ])

        cat_dir = appman_dir / folder
        cat_dir.mkdir(parents=True, exist_ok=True)
        stub = cat_dir / act_name
        if not stub.exists():
            stub.write_text("", encoding="utf-8")
        os.chmod(stub, 0o755)
        active_stubs_by_folder[folder].add(act_name)

    sys_cat_dir = appman_dir / "XDG_System"
    sys_cat_dir.mkdir(parents=True, exist_ok=True)
    for builtin_act in ("CkLaunch", "CkSoftwareCenter", "CkAdmin", "CkAdminDefaultApps", "CkAdminDateTime", "CkAdminFirmware"):
        bs = sys_cat_dir / builtin_act
        if not bs.exists():
            bs.write_text("", encoding="utf-8")
        os.chmod(bs, 0o755)
        active_stubs_by_folder["XDG_System"].add(builtin_act)

    # Clean stale CkXdg_* stubs removed from XDG directories
    for folder, keep in active_stubs_by_folder.items():
        cat_dir = appman_dir / folder
        if not cat_dir.is_dir():
            continue
        for child in cat_dir.iterdir():
            if (child.name.startswith("CkXdg_") or child.name in ("CkLaunch", "CkSoftwareCenter")) and child.name not in keep:
                try:
                    child.unlink()
                except OSError:
                    pass
        if not any(cat_dir.iterdir()):
            try:
                cat_dir.rmdir()
            except OSError:
                pass

    # Do not shadow CDE's built-in /usr/dt/appconfig/appmanager/C/Desktop_Apps
    if desktop_apps_dir.is_dir():
        for child in list(desktop_apps_dir.iterdir()):
            if child.name.startswith("CkXdg_") or child.name in ("CkLaunch", "CkSoftwareCenter"):
                try:
                    child.unlink()
                except OSError:
                    pass
        if not any(desktop_apps_dir.iterdir()):
            try:
                desktop_apps_dir.rmdir()
            except OSError:
                pass

    populated_curated, empty_curated = sync_curated_appmanager_groups(
        appman_dir, icons_dir, dt_lines
    )

    dt_out = types_dir / "ck-xdg-apps.dt"
    dt_tmp = types_dir / f".ck-xdg-apps.dt.{os.getpid()}.tmp"
    new_content = "\n".join(dt_lines) + "\n"
    changed = True
    if dt_out.is_file():
        try:
            changed = (dt_out.read_text(encoding="utf-8", errors="replace") != new_content)
        except OSError:
            changed = True

    dt_tmp.write_text(new_content, encoding="utf-8")
    os.replace(dt_tmp, dt_out)

    managed_folders = [f for f, _, _, _ in CATEGORIES if (appman_dir / f).is_dir()] + populated_curated
    sync_appmanager_session_links(home, managed_folders, prune_folders=empty_curated)

    if trigger_reload and changed and os.environ.get("DISPLAY"):
        dtaction = Path("/usr/dt/bin/dtaction")
        if dtaction.is_file() and os.access(dtaction, os.X_OK):
            try:
                subprocess.run(
                    [str(dtaction), "ReloadActions"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=1.5,
                    check=False,
                )
            except Exception:
                pass

    return len(entries)


def detect_mime_type(target: Path) -> str:
    try:
        with target.open("rb") as fp:
            hdr = fp.read(64)
        if hdr.startswith(b"%PDF-"):
            return "application/pdf"
        if hdr.startswith(b"\x89PNG\r\n\x1a\n"):
            return "image/png"
        if hdr.startswith(b"\xff\xd8\xff"):
            return "image/jpeg"
        if hdr.startswith((b"GIF87a", b"GIF89a")):
            return "image/gif"
        if len(hdr) >= 12 and hdr[:4] == b"RIFF" and hdr[8:12] == b"WEBP":
            return "image/webp"
        if b"<svg" in hdr.lower():
            return "image/svg+xml"
        if hdr.startswith(b"%!PS"):
            return "application/postscript"
    except OSError:
        pass

    ext_overrides = {
        ".pdf": "application/pdf",
        ".webp": "image/webp",
        ".svg": "image/svg+xml",
        ".mp4": "video/mp4",
        ".mkv": "video/x-matroska",
        ".webm": "video/webm",
        ".mp3": "audio/mpeg",
        ".flac": "audio/flac",
        ".ogg": "audio/ogg",
        ".wav": "audio/x-wav",
        ".odt": "application/vnd.oasis.opendocument.text",
        ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        ".xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        ".pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
    }
    ext = target.suffix.lower()
    if ext in ext_overrides:
        return ext_overrides[ext]

    guessed, _ = mimetypes.guess_type(str(target))
    if guessed:
        return guessed.lower()

    xdg_mime = which_prog("xdg-mime")
    if xdg_mime and target.exists():
        try:
            cp = subprocess.run([xdg_mime, "query", "filetype", str(target)],
                                capture_output=True, text=True, timeout=2.0, check=False)
            mt = cp.stdout.strip().lower()
            if mt and "/" in mt:
                return mt
        except Exception:
            pass
    return "application/octet-stream"


def read_mimeapps_candidates(mime_type: str) -> list[str]:
    home = Path(os.environ.get("HOME") or Path.home())
    cfg_home = Path(os.environ.get("XDG_CONFIG_HOME") or (home / ".config"))
    cfg_dirs = [Path(p) for p in os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":") if p.strip()]

    files = [cfg_home / "mimeapps.list"] + [d / "mimeapps.list" for d in cfg_dirs]
    for adir in xdg_app_dirs():
        files.append(adir / "mimeapps.list")
        files.append(adir / "mimeinfo.cache")

    ordered: list[str] = []
    major = mime_type.split("/", 1)[0] + "/*" if "/" in mime_type else ""

    for fpath in files:
        if not fpath.is_file():
            continue
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        try:
            cp.read(fpath, encoding="utf-8")
        except Exception:
            continue
        for sec in ("Default Applications", "Added Associations", "MIME Cache"):
            if not cp.has_section(sec):
                continue
            for key in (mime_type, major):
                if not key or not cp.has_option(sec, key):
                    continue
                raw = cp.get(sec, key)
                for did in raw.split(";"):
                    did = did.strip()
                    if did and did not in ordered:
                        ordered.append(did)
    return ordered


def open_via_xdg_mime(files: list[str], explicit_desktop_id: str = "", set_default: bool = False) -> int:
    if not files:
        return 2
    target = Path(files[0])
    mime_type = detect_mime_type(target)

    if set_default and explicit_desktop_id:
        set_mimeapps_default(mime_type, explicit_desktop_id)

    all_entries = collect_all_desktop_entries(include_nodisplay=True)
    candidates: list[str] = []
    if explicit_desktop_id:
        candidates.append(explicit_desktop_id)
    else:
        candidates.extend(read_mimeapps_candidates(mime_type))
        major = mime_type.split("/", 1)[0] + "/*" if "/" in mime_type else ""
        for did, ent in all_entries.items():
            if mime_type in ent["mimes"] or (major and major in ent["mimes"]):
                if did not in candidates:
                    candidates.append(did)

    for did in candidates:
        ent = all_entries.get(did)
        if not ent and not did.endswith(".desktop"):
            ent = all_entries.get(f"{did}.desktop")
        if not ent:
            continue
        cmd = expand_exec_with_files(ent, files)
        if not cmd:
            continue
        if ent["work_dir"]:
            try:
                os.chdir(ent["work_dir"])
            except OSError:
                pass
        if ent["terminal"] and os.access("/usr/dt/bin/dtterm", os.X_OK):
            os.execv("/usr/dt/bin/dtterm", ["dtterm", "-title", ent["name"], "-e", "/bin/sh", "-c", cmd])
        os.execv("/bin/sh", ["sh", "-c", cmd])
    return 2


def set_mimeapps_default(mime_type: str, desktop_id: str) -> None:
    if not mime_type or not desktop_id:
        return
    if not desktop_id.endswith(".desktop"):
        desktop_id = f"{desktop_id}.desktop"
    home = Path(os.environ.get("HOME") or Path.home())
    cfg_home = Path(os.environ.get("XDG_CONFIG_HOME") or (home / ".config"))
    cfg_home.mkdir(parents=True, exist_ok=True)
    mpath = cfg_home / "mimeapps.list"

    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str  # type: ignore[assignment]
    if mpath.is_file():
        try:
            cp.read(mpath, encoding="utf-8")
        except Exception:
            pass
    if not cp.has_section("Default Applications"):
        cp.add_section("Default Applications")
    cp.set("Default Applications", mime_type, desktop_id)

    if not cp.has_section("Added Associations"):
        cp.add_section("Added Associations")
    existing = [x.strip() for x in cp.get("Added Associations", mime_type, fallback="").split(";") if x.strip()]
    merged = [desktop_id] + [x for x in existing if x != desktop_id]
    cp.set("Added Associations", mime_type, ";".join(merged) + ";")

    tmp = cfg_home / f".mimeapps.list.{os.getpid()}.tmp"
    with tmp.open("w", encoding="utf-8") as fp:
        cp.write(fp, space_around_delimiters=False)
    os.replace(tmp, mpath)


def run_inotify_watcher(pidfile: str = "") -> int:
    stop = False

    def handle_sig(_signum, _frame):
        nonlocal stop
        stop = True

    signal.signal(signal.SIGTERM, handle_sig)
    signal.signal(signal.SIGINT, handle_sig)

    libc_name = ctypes.util.find_library("c")
    libc = ctypes.CDLL(libc_name, use_errno=True) if libc_name else None
    IN_CLOEXEC = 0x00080000
    IN_NONBLOCK = 0x00000800
    WATCH_MASK = 0x00000002 | 0x00000008 | 0x00000040 | 0x00000080 | 0x00000100 | 0x00000200

    ifd = -1
    if libc and hasattr(libc, "inotify_init1") and hasattr(libc, "inotify_add_watch"):
        libc.inotify_init1.argtypes = [ctypes.c_int]
        libc.inotify_init1.restype = ctypes.c_int
        libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        libc.inotify_add_watch.restype = ctypes.c_int
        ifd = libc.inotify_init1(IN_CLOEXEC | IN_NONBLOCK)

    watched: dict[Path, int] = {}

    def refresh_watches() -> None:
        if ifd < 0:
            return
        for adir in xdg_app_dirs():
            if not adir.is_dir():
                continue
            for root, dirs, _ in os.walk(adir):
                dirs[:] = [d for d in dirs if not d.startswith(".")]
                rp = Path(root)
                if rp not in watched:
                    wd = libc.inotify_add_watch(ifd, str(rp).encode("utf-8"), WATCH_MASK)
                    if wd >= 0:
                        watched[rp] = wd

    def dir_fingerprint() -> str:
        parts: list[str] = []
        for adir in xdg_app_dirs():
            if not adir.is_dir():
                continue
            for root, dirs, files in os.walk(adir):
                dirs[:] = [d for d in sorted(dirs) if not d.startswith(".")]
                for fn in sorted(files):
                    if fn.endswith(".desktop"):
                        fp = Path(root) / fn
                        try:
                            st = fp.stat()
                            parts.append(f"{fp}:{st.st_mtime_ns}:{st.st_size}")
                        except OSError:
                            pass
        return "|".join(parts)

    refresh_watches()
    last_snapshot = dir_fingerprint()
    run_index_once(trigger_reload=True)

    if pidfile:
        Path(pidfile).parent.mkdir(parents=True, exist_ok=True)
        Path(pidfile).write_text(f"{os.getpid()}\n", encoding="utf-8")

    try:
        while not stop:
            if ifd >= 0:
                r, _, _ = select.select([ifd], [], [], 2.0)
                if r:
                    # Drain queued events and debounce 350 ms for multi-file dpkg/flatpak transactions
                    while True:
                        try:
                            chunk = os.read(ifd, 4096)
                            if not chunk:
                                break
                        except BlockingIOError:
                            break
                        except OSError:
                            break
                    time.sleep(0.35)
                    while True:
                        try:
                            if not os.read(ifd, 4096):
                                break
                        except OSError:
                            break
                    refresh_watches()
                    snap = dir_fingerprint()
                    if snap != last_snapshot:
                        last_snapshot = snap
                        run_index_once(trigger_reload=True)
                else:
                    # Periodically pick up newly created XDG_DATA_HOME/applications directories
                    refresh_watches()
                    snap = dir_fingerprint()
                    if snap != last_snapshot:
                        last_snapshot = snap
                        run_index_once(trigger_reload=True)
            else:
                time.sleep(2.0)
                snap = dir_fingerprint()
                if snap != last_snapshot:
                    last_snapshot = snap
                    run_index_once(trigger_reload=True)
    finally:
        if ifd >= 0:
            os.close(ifd)
        if pidfile:
            try:
                Path(pidfile).unlink()
            except OSError:
                pass
    return 0


def main(argv: list[str]) -> int:
    watch = False
    pidfile = ""
    open_mime = False
    set_def = False
    desktop_id = ""
    rest: list[str] = []

    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("--xdg", "--once"):
            i += 1
        elif a in ("--watch", "--daemon"):
            watch = True
            i += 1
        elif a == "--pidfile" and i + 1 < len(argv):
            pidfile = argv[i + 1]
            i += 2
        elif a == "--open-mime":
            open_mime = True
            i += 1
        elif a == "--desktop-id" and i + 1 < len(argv):
            desktop_id = argv[i + 1]
            i += 2
        elif a == "--set-default":
            set_def = True
            i += 1
        elif a in ("-h", "--help"):
            print("Usage: dtappintegrate --xdg [--watch [--pidfile <file>]]\n"
                  "       dtappintegrate-xdg --open-mime [--desktop-id <id>] [--set-default] <file...>")
            return 0
        else:
            rest.append(a)
            i += 1

    if open_mime:
        return open_via_xdg_mime(rest, explicit_desktop_id=desktop_id, set_default=set_def)
    if watch:
        return run_inotify_watcher(pidfile=pidfile)

    count = run_index_once(trigger_reload=True)
    if os.environ.get("DTAPPINTEGRATE_VERBOSE"):
        print(f"dtappintegrate --xdg: indexed {count} XDG application(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
