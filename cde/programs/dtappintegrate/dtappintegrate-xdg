def xdg_app_dirs() -> list[Path]:
    dirs: list[Path] = []
    home = Path(os.environ.get("HOME") or Path.home())
    xdg_data_home = Path(os.environ.get("XDG_DATA_HOME") or (home / ".local" / "share"))
    dirs.append(xdg_data_home / "applications")

    raw_dirs = os.environ.get("XDG_DATA_DIRS", "")
    if raw_dirs.strip():
        parts = [p for p in raw_dirs.split(":") if p.strip()]
    else:
        parts = [
            "/usr/local/share",
            "/usr/share",
            "/var/lib/flatpak/exports/share",
            "/var/lib/snapd/desktop",
        ]
    for p in parts:
        cand = Path(p) / "applications"
        if cand not in dirs:
            dirs.append(cand)
    return dirs


def xdg_icon_roots() -> list[Path]:
    home = Path(os.environ.get("HOME") or Path.home())
    xdg_data_home = Path(os.environ.get("XDG_DATA_HOME") or (home / ".local" / "share"))
    roots = [xdg_data_home / "icons", home / ".icons"]
    raw_dirs = os.environ.get("XDG_DATA_DIRS", "")
    parts = [p for p in raw_dirs.split(":") if p.strip()] if raw_dirs.strip() else [
        "/usr/local/share",
        "/usr/share",
        "/var/lib/flatpak/exports/share",
        "/var/lib/snapd/desktop",
    ]
    for p in parts:
        roots.append(Path(p) / "icons")
        roots.append(Path(p) / "pixmaps")
    return roots


def which_prog(prog: str) -> str | None:
    if not prog:
        return None
    if "/" in prog:
        return prog if os.access(prog, os.X_OK) else None
    path_env = os.environ.get("PATH") or "/usr/dt/bin:/usr/local/bin:/usr/bin:/bin"
    return shutil.which(prog, path=path_env)


def parse_desktop_entry(path: Path, desktop_id: str) -> dict | None:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None

    in_entry = False
    seen_entry = False
    kv: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            in_entry = (line == "[Desktop Entry]")
            if in_entry:
                seen_entry = True
            continue
        if not in_entry or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        v = v.strip()
        if k not in kv:
            kv[k] = v

    if not seen_entry:
        return None
    if kv.get("Type", "Application") != "Application":
        return None
    if kv.get("Hidden", "").lower() == "true":
        return None

    lang = (os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").split(".")[0].split("@")[0]
    lang_short = lang.split("_")[0] if lang not in ("", "C", "POSIX") else ""
    name = (
        (kv.get(f"Name[{lang}]") if lang else None)
        or (kv.get(f"Name[{lang_short}]") if lang_short else None)
        or kv.get("Name", "")
    )
    raw_exec = kv.get("Exec", "")
    if not name or not raw_exec:
        return None

    try_exec = kv.get("TryExec", "")
    if try_exec and not which_prog(try_exec):
        return None

    not_show = [t.strip() for t in kv.get("NotShowIn", "").split(";") if t.strip()]
    only_show = [t.strip() for t in kv.get("OnlyShowIn", "").split(";") if t.strip()]
    if "CDE" in not_show:
        return None

    cats = [t.strip() for t in kv.get("Categories", "").split(";") if t.strip()]
    mimes = [t.strip().lower() for t in kv.get("MimeType", "").split(";") if t.strip()]

    return {
        "id": desktop_id,
        "path": str(path),
        "name": name,
        "generic_name": kv.get("GenericName", ""),
        "comment": kv.get("Comment", ""),
        "exec": raw_exec,
        "icon": kv.get("Icon", ""),
        "terminal": kv.get("Terminal", "").lower() == "true",
        "no_display": kv.get("NoDisplay", "").lower() == "true",
        "only_show": only_show,
        "categories": cats,
        "mimes": mimes,
        "work_dir": kv.get("Path", ""),
    }


def collect_all_desktop_entries(include_nodisplay: bool = False) -> dict[str, dict]:
    entries: dict[str, dict] = {}
    for app_dir in xdg_app_dirs():
        if not app_dir.is_dir():
            continue
        for root, dirs, files in os.walk(app_dir):
            dirs[:] = [d for d in sorted(dirs) if not d.startswith(".")]
            rel = Path(root).relative_to(app_dir)
            prefix = "-".join(rel.parts) + "-" if rel.parts else ""
            for fn in sorted(files):
                if not fn.endswith(".desktop") or fn.startswith("."):
                    continue
                did = f"{prefix}{fn}"
                if did in entries:
                    continue
                parsed = parse_desktop_entry(Path(root) / fn, did)
                if not parsed:
                    continue
                if not include_nodisplay:
                    if parsed["no_display"]:
                        continue
                    if parsed["only_show"] and "CDE" not in parsed["only_show"]:
                        continue
                entries[did] = parsed
    return entries


def expand_exec_for_cde_dt(entry: dict, with_file_args: bool) -> str:
    raw = entry["exec"]
    name_q = shlex.quote(entry["name"])
    path_q = shlex.quote(entry["path"])
    icon_part = f"--icon {shlex.quote(entry['icon'])}" if entry["icon"] else ""

    out: list[str] = []
    i = 0
    used_file_arg = False
    while i < len(raw):
        ch = raw[i]
        if ch == "%" and i + 1 < len(raw):
            code = raw[i + 1]
            i += 2
            if code == "%":
                out.append("%")
            elif code in ("f", "F", "u", "U"):
                if with_file_args:
                    out.append('"%(File)Args%"')
                    used_file_arg = True
            elif code == "c":
                out.append(name_q)
            elif code == "i":
                out.append(icon_part)
            elif code == "k":
                out.append(path_q)
        else:
            out.append(ch)
            i += 1

    cmd = "".join(out).strip()
    if with_file_args and not used_file_arg:
        cmd = f'{cmd} "%(File)Args%"'
    if entry["work_dir"]:
        wd = shlex.quote(entry["work_dir"])
        cmd = f"sh -c 'cd {wd} 2>/dev/null || true; exec {cmd}'"
    return cmd


def expand_exec_with_files(entry: dict, files: list[str]) -> str:
    raw = entry["exec"]
    quoted_files = " ".join(shlex.quote(f) for f in files)
    first_file = shlex.quote(files[0]) if files else ""
    name_q = shlex.quote(entry["name"])
    path_q = shlex.quote(entry["path"])
    icon_part = f"--icon {shlex.quote(entry['icon'])}" if entry["icon"] else ""

    out: list[str] = []
    i = 0
    used_files = False
    while i < len(raw):
        ch = raw[i]
        if ch == "%" and i + 1 < len(raw):
            code = raw[i + 1]
            i += 2
            if code == "%":
                out.append("%")
            elif code in ("F", "U"):
                if quoted_files:
                    out.append(quoted_files)
                    used_files = True
            elif code in ("f", "u"):
                if first_file:
                    out.append(first_file)
                    used_files = True
            elif code == "c":
                out.append(name_q)
            elif code == "i":
                out.append(icon_part)
            elif code == "k":
                out.append(path_q)
        else:
            out.append(ch)
            i += 1

    cmd = "".join(out).strip()
    if files and not used_files:
        cmd = f"{cmd} {quoted_files}"
    return cmd


def resolve_icon_for_cde(icon_spec: str, fallback_cde_icon: str, user_icons_dir: Path, slug: str) -> str:
    if not icon_spec:
        return fallback_cde_icon

    cands: list[Path] = []
    p = Path(icon_spec)
    if p.is_absolute():
        if p.is_file():
            cands.append(p)
    else:
        stem = p.stem if p.suffix in (".png", ".xpm", ".pm") else icon_spec
        for root in xdg_icon_roots():
            if not root.is_dir():
                continue
            for sub in (
                "hicolor/48x48/apps",
                "hicolor/32x32/apps",
                "hicolor/16x16/apps",
                "Adwaita/48x48/apps",
                "Yaru/48x48/apps",
                "",
            ):
                base = (root / sub) if sub else root
                for ext in (".xpm", ".pm", ".png"):
                    cand = base / f"{stem}{ext}"
                    if cand.is_file():
                        cands.append(cand)
            if cands:
                break

    if not cands:
        return fallback_cde_icon

    chosen = cands[0]
    user_icons_dir.mkdir(parents=True, exist_ok=True)
    icon_base = f"ckxdg_{slug}"
    if chosen.suffix in (".xpm", ".pm"):
        for sz in ("l", "m", "t"):
            dst = user_icons_dir / f"{icon_base}.{sz}.pm"
            if not dst.exists():
                shutil.copyfile(chosen, dst)
        return icon_base
    if chosen.suffix == ".png":
        for sz in ("l", "m", "t"):
            dst = user_icons_dir / f"{icon_base}.{sz}.png"
            if not dst.exists():
                shutil.copyfile(chosen, dst)
        return icon_base
    return fallback_cde_icon


def map_entry_category(entry: dict) -> tuple[str, str, str]:
    cats = set(entry["categories"])
    for folder, label, cde_icon, match_cats in CATEGORIES:
        if cats.intersection(match_cats):
            return folder, label, cde_icon
    return "XDG_Utilities", "Utilities & Accessories", "Dtadskt"


