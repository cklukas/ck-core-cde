def discover_software_store_cmd() -> tuple[str, str]:
    for prog, label in (
        ("snap-store", "Ubuntu App Center"),
        ("gnome-software", "Software Center"),
        ("synaptic", "Synaptic Package Manager"),
        ("update-manager", "Software Updater"),
